# ==============================================================================
# Enterprise AI Analyst - Development Environment Configuration
# ==============================================================================

APP_NAME="Enterprise AI Analyst (Dev)"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

JWT_SECRET_KEY=dev-insecure-jwt-secret-key-at-least-32-bytes-long-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_analyst
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

WORKER_CONCURRENCY=4
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=storage
PROMETHEUS_METRICS_ENABLED=true
