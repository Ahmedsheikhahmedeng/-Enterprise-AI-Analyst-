# ==============================================================================
# Enterprise AI Analyst - Universal Baseline Environment Template
# ==============================================================================

# Application
APP_NAME="Enterprise AI Analyst"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-at-least-32-bytes-long-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backing Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_analyst
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=5.0

QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT=30
QDRANT_COLLECTION_PREFIX=enterprise_ai

# Worker Configuration
WORKER_CONCURRENCY=8
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30.0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=25

# Observability
OTEL_ENABLED=false
PROMETHEUS_METRICS_ENABLED=true
