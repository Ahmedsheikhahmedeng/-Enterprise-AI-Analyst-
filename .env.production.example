# ==============================================================================
# Enterprise AI Analyst - Production Environment Template
# Copy this file to .env.production on deployment target (DO NOT COMMIT SECRETS)
# ==============================================================================

APP_NAME="Enterprise AI Analyst"
APP_VERSION="0.1.0"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS: Set to explicit production frontend domain(s). NEVER use wildcard '*'.
CORS_ORIGINS=https://analyst.enterprise.internal,https://app.analyst.domain.com

# Security: Generate high-entropy 256-bit cryptographic secrets (>32 characters)
# Example: openssl rand -base64 32
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_32_CHAR_PRODUCTION_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backing Infrastructure - Authenticated internal network targets
DATABASE_URL=postgresql+asyncpg://analyst_prod_user:SECURE_DB_PASSWORD@postgres:5432/enterprise_ai_analyst_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_RECYCLE=1800

# Redis with Authentication
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis:6379/0
REDIS_CONNECT_TIMEOUT=5.0

# Qdrant Vector Engine
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT=30
QDRANT_COLLECTION_PREFIX=enterprise_ai_prod

# Worker Settings
WORKER_CONCURRENCY=16
WORKER_SHUTDOWN_TIMEOUT_SECONDS=45.0

# Observability & Metrics
PROMETHEUS_METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
