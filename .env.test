# ==============================================================================
# Enterprise AI Analyst - Test Environment Configuration
# ==============================================================================

APP_NAME="Enterprise AI Analyst (Test)"
APP_VERSION="0.1.0"
ENVIRONMENT=testing
DEBUG=false
LOG_LEVEL=WARNING
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://testserver

JWT_SECRET_KEY=test-jwt-secret-key-must-be-at-least-32-chars-long-987654
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_analyst_test
REDIS_URL=redis://localhost:6379/15
QDRANT_URL=http://localhost:6333

WORKER_CONCURRENCY=2
RUN_INTEGRATION_TESTS=false
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=tests/fixtures/storage
