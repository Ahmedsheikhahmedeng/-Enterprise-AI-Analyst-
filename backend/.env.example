# ==============================================================================
# Enterprise AI Analyst - Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="Enterprise AI Analyst API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# Infrastructure Services
# Note: When running inside Docker Compose, use service hostnames:
# postgres, redis, qdrant.
# For local host development without Docker, use localhost:5432, localhost:6379, etc.
# ------------------------------------------------------------------------------

# PostgreSQL Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/enterprise_ai_analyst"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_RECYCLE=1800

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_CONNECT_TIMEOUT=5.0

# Qdrant Vector Search Engine Configuration
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=""
QDRANT_TIMEOUT=5.0

# Infrastructure Lifespan & Retries
INFRASTRUCTURE_STARTUP_RETRIES=3
INFRASTRUCTURE_RETRY_DELAY=1.0

# Testing
RUN_INTEGRATION_TESTS=false

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="generate-a-secure-random-64-character-hex-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_BACKEND="local"
LOCAL_STORAGE_ROOT="storage"
MAX_UPLOAD_SIZE_MB=25

# S3 Configuration (Optional for local development; required if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=""
S3_BUCKET="enterprise-documents"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Document Ingestion & Parser Limits
# ------------------------------------------------------------------------------
MAX_INGESTION_PAGES=500
MAX_INGESTION_ROWS=50000
MAX_INGESTION_SHEETS=20
MAX_EXTRACTED_CHARACTERS=5000000
AUTO_INGEST=true
